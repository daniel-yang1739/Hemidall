# ==========================================
# 💎 Obsidian Vault Configuration (Strict Whitelist)
# ==========================================
# By default, ignore ALL internal Obsidian files and runtime state
docs/.obsidian/*
.obsidian/*

# Whitelist: ONLY allow explicit core configuration files to be tracked
!docs/.obsidian/app.json
!docs/.obsidian/appearance.json
!docs/.obsidian/core-plugins.json
!docs/.obsidian/community-plugins.json

!.obsidian/app.json
!.obsidian/appearance.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json

# ==========================================
# 🐹 Golang Build & Temporary Artifacts
# ==========================================
*.tmp
*.tmp_*
.tmp_*
bin/
dist/
*.exe
*.test
*.out

# ==========================================
# 🍏 macOS & System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# ⚙️ IDE & Editor Files
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
